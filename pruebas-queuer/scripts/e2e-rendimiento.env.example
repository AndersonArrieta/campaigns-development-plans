# Plantilla de variables para scripts/e2e_rendimiento_queuer.py (T-039) y
# scripts/jmeter_e2e_rendimiento_queuer.py (T-040).
# Copiala a la raiz de pruebas-queuer (p. ej. queuer-dev.env) y completa los valores.
# Los archivos *.env estan ignorados por git: no versiones credenciales.
# Cualquier valor tambien se puede pasar como variable de entorno QE2E_<NOMBRE>.

# URL base del queuer. QA: https://informacion-ext-qa.apps.ambientesbc.com
HOST=
# Prefijo de las rutas del queuer. QA: /artemis/platform/queuer/v1
PREFIX=
# Endpoint del token de Cognito.
# QA: https://chatbots-artemis-qa.auth.us-east-1.amazoncognito.com/oauth2/token
# Dev: el del user pool chatbots-artemis-dev (ver queuer-cognito-recipe-test/config.env)
COGNITO_URL=
# Cliente client_credentials autorizado por la AuthorizationPolicy del queuer del ambiente
CLIENT_ID=
# Si lo dejas vacio, el script lo pide por consola sin mostrarlo
CLIENT_SECRET=
# Base del fakechannel, sin /whatsapp/get-messages.
# QA: https://informacion-ext-qa.apps.ambientesbc.com/artemis/platform/fake-channel/v1
ENDPOINT_GET_MESSAGE_FAKE=
