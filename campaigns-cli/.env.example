# Plantilla de configuración de campaigns-cli.
# Copia este archivo a .env y completa los valores. No pongas credenciales AWS aquí:
# usa AWS_PROFILE con un perfil o SSO (`aws sso login --profile <perfil>`).
# Prioridad: variables de entorno del proceso > este archivo > valores por defecto.

# --- Entorno ---
CAMPAIGNS_ENV=dev                      # dev | qa | prod (prod: solo comandos de lectura)
AWS_PROFILE=                           # perfil de ~/.aws/config; vacío = cadena estándar de boto3
AWS_REGION=us-east-1

# --- Recursos ---
CAMPAIGNS_INPUT_BUCKET=                # bucket que dispara ingester_Lambda
CAMPAIGNS_INPUT_PREFIX=campaigns/input/
CAMPAIGNS_TABLE_NAME=                  # tabla DynamoDB de campañas
CAMPAIGNS_TABLE_CAMPAIGN_INDEX=        # GSI por campaign_id (vacío = scan filtrado)
INGESTER_LAMBDA_NAME=
SCHEDULER_LAMBDA_NAME=

# --- Logs (log groups separados por coma) ---
CAMPAIGNS_LOG_GROUPS=

# --- Comportamiento ---
CLI_OUTPUT=table                       # table | json
CLI_WAIT_TIMEOUT_SECONDS=120
CLI_POLL_INTERVAL_SECONDS=5
CLI_TEST_APP_ID=others-test            # app_id de los datos de prueba (y de la limpieza)
