# Plantilla de configuración de campaigns-cli.
# Copia este archivo a .env y completa los valores. El .env NO se versiona (.gitignore):
# nunca pongas credenciales en este archivo de ejemplo.
# Prioridad: variables de entorno del proceso > .env > valores por defecto.

# --- Entorno ---
CAMPAIGNS_ENV=dev                      # dev | qa | prod (prod: solo comandos de lectura)
AWS_REGION=us-east-1

# --- Credenciales AWS ---
# Si se definen, tienen prioridad sobre AWS_PROFILE. Van juntas KEY_ID + SECRET;
# AWS_SESSION_TOKEN solo para credenciales temporales (ASIA...), que vencen.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=                           # alternativa: perfil de ~/.aws/config

# --- Recursos ---
# Nombres por ambiente (de Platform_test e ingester_Lambda), reemplazando {env} por dev, qa...
CAMPAIGNS_INPUT_BUCKET=                # nu0284001-artemis-chatbots-platform-{env}-campaigns-data
CAMPAIGNS_INPUT_PREFIX=                # vacío: Platform_test sube el CSV a la raíz del bucket
CAMPAIGNS_TABLE_NAME=                  # nu0284001-artemis-chatbots-platform-{env}-scheduled-campaigns
CAMPAIGNS_TABLE_CAMPAIGN_INDEX=        # GSI por campaign_id; hoy no existe (vacío = scan filtrado)
CAMPAIGNS_LOGS_TABLE_NAME=             # nu0284001-artemis-chatbots-platform-{env}-scheduled-campaigns-logs
INGESTER_LAMBDA_NAME=                  # nu0284001-artemis-plc-{env}-campaigns-ingester-lambda
SCHEDULER_LAMBDA_NAME=                 # nu0284001-artemis-plc-{env}-campaigns-scheduler-lambda

# --- Fake channel (grupo channel: verificación de entrega) ---
# Valores en las propiedades del pipeline de Platform_test: -DcognitoEndpoint, -DclientId,
# -DclientSecret y -DendpointGetMessageFake. El client secret NUNCA va en este archivo.
COGNITO_TOKEN_URL=                     # https://chatbots-artemis-{env}.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
FAKE_CHANNEL_BASE_URL=                 # https://informacion-ext-{env}.apps.ambientesbc.com/artemis/platform/fake-channel/v1
FAKE_CHANNEL_VERIFY_SSL=true           # false si el certificado del ambiente no es de confianza (Platform_test lo ignora)

# --- EKS (grupo pods: logs de los pods de platform_campaigns_ms) ---
EKS_CLUSTER_NAME=                      # eks-informacion-{env}
EKS_NAMESPACE=                         # artemis-{env}
CAMPAIGNS_POD_SELECTOR=app=platform-campaigns-others-v2

# --- Logs (log groups separados por coma) ---
# Vacío: se usan los de las lambdas (/aws/lambda/<INGESTER_LAMBDA_NAME>, /aws/lambda/<SCHEDULER_LAMBDA_NAME>).
CAMPAIGNS_LOG_GROUPS=

# --- Comportamiento ---
CLI_OUTPUT=table                       # table | json
CLI_WAIT_TIMEOUT_SECONDS=120
CLI_POLL_INTERVAL_SECONDS=5
CLI_TEST_APP_ID=others-test            # app_id de los datos de prueba (y de la limpieza)
