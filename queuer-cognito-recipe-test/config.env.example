# Copia este archivo como config.env y completa los valores.
# NO subas config.env a ningun repositorio: contiene el client secret.

# --- Hosts y prefijos del VirtualService (variables del release de queuer_ms) ---
SCHEME=https
GW_INT=<gateway-host-internal>
GW_EXT=<gateway-host-external>
PREFIX_INT=<vs-internal-match>
PREFIX_EXT=<vs-external-match>

# Rutas dentro del microservicio (ajustar si el rewrite del VS las cambia)
QUEUER_PATH=/queuer
HEALTH_PATH=/actuator/health

# --- Cognito (mismos valores que -DclientId / -DclientSecret / -DcognitoEndpoint de Platform_test) ---
COGNITO_URL=<dominio-user-pool-cognito>
CLIENT_ID=<client-id>
CLIENT_SECRET=<client-secret>
# Alternativa: pasar un token ya generado y omitir los tres valores anteriores
# TOKEN=

# Opciones extra de curl, ej: -k para certificados no confiables
CURL_OPTS=
CURL_TIMEOUT=20

# --- Regla 1 (opcional): pruebas desde pods dentro del cluster con kubectl ---
RUN_RULE1=false
K8S_SERVICE_URL=http://<bot-platform-distinctive>-queuer-<version>-service.<namespace>.svc.cluster.local:<service-port>
ALLOWED_NS=<namespace-en-jwt-allowed-namespaces>
ALLOWED_POD=<pod-con-curl-y-sidecar-istio>
ALLOWED_CONTAINER=
DENIED_NS=<namespace-fuera-de-la-lista>
DENIED_POD=<pod-con-curl-y-sidecar-istio>
DENIED_CONTAINER=
